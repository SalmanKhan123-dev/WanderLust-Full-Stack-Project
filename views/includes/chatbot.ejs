}


.wl-ai-status span {

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #10b981;
}


.wl-ai-close {

  width: 32px;
  height: 32px;

  border: none;

  display: flex;
  align-items: center;
  justify-content: center;

