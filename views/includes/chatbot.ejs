<!-- =========================================================
     WANDERLUST AI TRAVEL ASSISTANT
========================================================= -->

<div class="wl-ai-widget">

  <!-- Floating Button -->
  <button
    type="button"
    class="wl-ai-button"
    id="wlAiButton"
    aria-label="Open WanderLust AI Assistant"
  >
    <span class="wl-ai-button-icon">
      <i class="fa-solid fa-sparkles"></i>
    </span>

    <span class="wl-ai-button-text">
      WanderLust AI
    </span>
  </button>


  <!-- Chat Window -->
  <div
    class="wl-ai-chat"
    id="wlAiChat"
    aria-hidden="true"
  >

    <!-- HEADER -->
    <div class="wl-ai-header">

      <div class="wl-ai-header-left">

        <div class="wl-ai-avatar">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>

        <div>
          <h3>WanderLust AI</h3>

          <div class="wl-ai-status">
            <span></span>
            Travel Assistant
          </div>
        </div>

      </div>


      <button
        type="button"
        class="wl-ai-close"
        id="wlAiClose"
        aria-label="Close assistant"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>

    </div>


    <!-- MESSAGES -->
    <div
      class="wl-ai-messages"
      id="wlAiMessages"
    >

      <!-- Welcome Message -->
      <div class="wl-ai-message assistant">

        <div class="wl-ai-message-avatar">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>

        <div class="wl-ai-bubble">

          <p>
            Hi! I'm your WanderLust travel assistant.
          </p>

          <p>
            I can help you find stays, plan trips,
            discover destinations, and choose a stay
            based on your budget.
          </p>

        </div>

      </div>


      <!-- SUGGESTIONS -->
      <div
        class="wl-ai-suggestions"
        id="wlAiSuggestions"
      >

        <button
          type="button"
          class="wl-ai-suggestion"
          data-message="Find me a stay"
        >
          <i class="fa-solid fa-magnifying-glass"></i>
          Find a stay
        </button>


        <button
          type="button"
          class="wl-ai-suggestion"
          data-message="Suggest a budget-friendly destination in India"
        >
          <i class="fa-solid fa-location-dot"></i>
          Budget destinations
        </button>


        <button
          type="button"
          class="wl-ai-suggestion"
          data-message="Plan a 3 day trip to Goa"
        >
          <i class="fa-solid fa-umbrella-beach"></i>
          Plan a Goa trip
        </button>


        <button
          type="button"
          class="wl-ai-suggestion"
          data-message="What should I look for when choosing a hotel?"
        >
          <i class="fa-solid fa-hotel"></i>
          Choose a stay
        </button>

      </div>

    </div>


    <!-- TYPING INDICATOR -->
    <div
      class="wl-ai-typing"
      id="wlAiTyping"
    >

      <span></span>
      <span></span>
      <span></span>

      <small>
        WanderLust AI is thinking...
      </small>

    </div>


    <!-- INPUT -->
    <form
      class="wl-ai-input-area"
      id="wlAiForm"
    >

      <input
        type="text"
        id="wlAiInput"
        placeholder="Ask about destinations, stays..."
        autocomplete="off"
        maxlength="1000"
      />

      <button
        type="submit"
        id="wlAiSend"
        aria-label="Send message"
      >
        <i class="fa-solid fa-paper-plane"></i>
      </button>

    </form>

  </div>

</div>


<style>

/* =========================================================
   WANDERLUST AI WIDGET
========================================================= */

.wl-ai-widget {
  position: fixed;
  right: 28px;
  bottom: 28px;
  z-index: 9999;
  font-family: inherit;
}


/* =========================================================
   FLOATING BUTTON
========================================================= */

.wl-ai-button {

  border: none;

  display: flex;
  align-items: center;
  gap: 10px;

  padding: 12px 18px;

  border-radius: 999px;

  background: #0d9488;
  color: #ffffff;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  box-shadow:
    0 8px 25px rgba(13, 148, 136, 0.28);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}


.wl-ai-button:hover {

  background: #0f766e;

  transform: translateY(-2px);

  box-shadow:
    0 12px 30px rgba(13, 148, 136, 0.35);
}


.wl-ai-button-icon {

  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(255,255,255,0.18);

  font-size: 14px;
}


/* =========================================================
   CHAT WINDOW
========================================================= */

.wl-ai-chat {

  position: absolute;

  right: 0;
  bottom: 64px;

  width: 410px;
  height: 610px;

  display: none;
  flex-direction: column;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 20px;

  box-shadow:
    0 25px 70px rgba(15, 23, 42, 0.18);

  animation: wlAiOpen 0.2s ease;
}


.wl-ai-chat.active {
  display: flex;
}


@keyframes wlAiOpen {

  from {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

}


/* =========================================================
   HEADER
========================================================= */

.wl-ai-header {

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 16px 18px;

  background: #ffffff;

  border-bottom: 1px solid #eef0f2;
}


.wl-ai-header-left {

  display: flex;
  align-items: center;

  gap: 11px;
}


.wl-ai-avatar {

  width: 40px;
  height: 40px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 12px;

  background: #e6fffb;

  color: #0d9488;

  font-size: 17px;
}


.wl-ai-header h3 {

  margin: 0;

  color: #111827;

  font-size: 15px;

  font-weight: 650;
}


.wl-ai-status {

  display: flex;
  align-items: center;

  gap: 5px;

  margin-top: 3px;

  color: #6b7280;

