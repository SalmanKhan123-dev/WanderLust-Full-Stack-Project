<% layout("/layouts/boilerplate")%>

<style>
  .auth-card {
    background: white;
    border-radius: 1.2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    padding: 2.5rem;
    text-align: center;
  }
  .auth-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #e6f4f3;
    color: #0d9488;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin: 0 auto 1rem auto;
  }
  .auth-heading {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 1.7rem;
    margin-bottom: 0.3rem;
  }
  .auth-subtext {
    color: #666;
    margin-bottom: 1.8rem;
    font-size: 0.95rem;
  }
  .auth-form {
    text-align: left;
  }
  .form-control:focus {
    border-color: #0d9488;
    box-shadow: 0 0 0 0.2rem rgba(13, 148, 136, 0.15);
  }
  .btn-teal {
    background-color: #0d9488;
    color: white;
    border: none;
  }
  .btn-teal:hover {
    background-color: #0f766e;
    color: white;
  }
  .auth-footer-link {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: #666;
  }
  .auth-footer-link a {
    color: #0d9488;
    text-decoration: none;
    font-weight: 600;
  }
</style>

<body>
  <div class="row mt-5 mb-5">
    <div class="col-lg-4 offset-lg-4 col-md-6 offset-md-3">

      <div class="auth-card">
        <div class="auth-icon"><i class="fa-solid fa-compass"></i></div>
        <h3 class="auth-heading">Welcome back</h3>
        <p class="auth-subtext">Log in to continue exploring Wanderlust</p>

        <form method="POST" action="/login" class="needs-validation auth-form" novalidate>
          <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input type="text" name="username" id="username" class="form-control" required>
          </div>
          <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <input type="password" name="password" id="password" class="form-control" required>
          </div>
          <button class="btn btn-teal w-100 py-2">Log In</button>
        </form>

        <p class="auth-footer-link">New here? <a href="/signup">Create an account</a></p>
      </div>

    </div>
  </div>
</body>