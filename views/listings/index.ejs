<% layout("/layouts/boilerplate") %>

<style>
  .hero {
    position: relative;
    height: 46vh;
    min-height: 320px;
    border-radius: 1.5rem;
    overflow: hidden;
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #0d9488;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=60");
    background-size: cover;
    background-position: center;
    opacity: 0.35;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 1rem;
  }

  .hero-content h1 {
    font-family: "Fraunces", serif;
    font-weight: 600;
    font-size: 2.6rem;
    margin-bottom: 0.5rem;
  }

  .hero-content p {
    font-size: 1.05rem;
    opacity: 0.95;
    margin-bottom: 0;
  }

  .filter-section {
    margin-bottom: 2.2rem;
    width: 100%;
  }

  #filters {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.15rem 0.2rem 0.6rem;
    scrollbar-width: none;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 0.9rem;
    min-height: 40px;
    border-radius: 999px;
    border: 1px solid #e2e2e2;
    background: #fff;
    color: #444;
    font-size: 0.84rem;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .filter:hover {
    border-color: #0d9488;
    color: #0d9488;
    background: #f0fdfa;
    transform: translateY(-1px);
  }

  .filter.active {
    background: #0d9488;
    border-color: #0d9488;
    color: white;
    font-weight: 600;
  }

  .tax-toggle {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    padding: 0.5rem 0.8rem;
    border: 1px solid #e2e2e2;
    border-radius: 999px;
    background: #fff;
    color: #444;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .tax-label {
    margin: 0;
    cursor: pointer;
    line-height: 1;
  }

  .tax-switch {
    position: relative;
    width: 36px;
    height: 21px;
    flex-shrink: 0;
    display: block;
  }

  .tax-switch input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }

  .tax-slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background-color: #d1d5db;
    border-radius: 999px;
    transition: 0.25s ease;
  }

  .tax-slider::before {
    content: "";
    position: absolute;
    width: 15px;
    height: 15px;
    left: 3px;
    top: 3px;
    background-color: white;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    transition: 0.25s ease;
  }

  .tax-switch input:checked + .tax-slider {
    background-color: #0d9488;
  }

  .tax-switch input:checked + .tax-slider::before {
    transform: translateX(15px);
  }

  .tax-info {
    display: none;
    color: #0d9488;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .listing-card {
    border: none !important;
    border-radius: 1.1rem;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .listing-link {
    text-decoration: none;
    color: inherit;
  }

  .listing-link:hover .listing-card {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }

  .card-img-top {
    height: 15rem;
    object-fit: cover;
    border-radius: 0 !important;
  }

  .card-body {
    padding: 0.8rem 0.1rem !important;
  }

  .card-text {
    margin-bottom: 0;
  }

  .card-text b {
    font-size: 1rem;
    font-weight: 600;
  }

  .price-line {
    color: #444;
    font-size: 0.95rem;
  }

  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pagination-btn,
  .page-number {
    text-decoration: none;
    color: #111;
  }

  .pagination-btn {
    padding: 0.55rem 1rem;
    border: 1px solid #ddd;
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .pagination-btn:hover {
    border-color: #0d9488;
    color: #0d9488;
  }

  .page-number {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .page-number:hover {
    color: #0d9488;
  }

  .page-number.active-page {
    min-width: 48px;
    height: 48px;
    background: #222;
    color: white;
    font-size: 1.1rem;
    font-weight: 600;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
  }

  .no-listings {
    text-align: center;
    padding: 4rem 1rem;
    color: #666;
  }

  @media (max-width: 576px) {
    .hero {
      height: 38vh;
      min-height: 260px;
    }

    .hero-content h1 {
      font-size: 1.8rem;
    }

    .hero-content p {
      font-size: 0.9rem;
    }

    .pagination-container {
      gap: 0.5rem;
    }

    .page-numbers {
      gap: 0.3rem;
    }
  }
</style>


<div class="container-fluid">

  <div class="hero">
    <div class="hero-content">
      <h1>
        Find your next stay, anywhere in the world
      </h1>

      <p>
        Handpicked homes, cabins, and villas for every kind of traveler
      </p>
    </div>
  </div>


  <div class="filter-section">

    <div id="filters">

      <a
        href="/listings"
        class="filter <%= !category || category === 'trending' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-fire"></i>
        Trending
      </a>


      <a
        href="/listings?category=rooms"
        class="filter <%= category === 'rooms' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-bed"></i>
        Rooms
      </a>


      <a
        href="/listings?category=farms"
        class="filter <%= category === 'farms' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-cow"></i>
        Farms
      </a>


      <a
        href="/listings?category=beach"
        class="filter <%= category === 'beach' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-umbrella-beach"></i>
        Beach
      </a>


      <a
        href="/listings?category=mountains"
        class="filter <%= category === 'mountains' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-mountain"></i>
        Mountains
      </a>


      <a
        href="/listings?category=cabins"
        class="filter <%= category === 'cabins' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-house"></i>
        Cabins
      </a>


      <a
        href="/listings?category=hotels"
        class="filter <%= category === 'hotels' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-hotel"></i>
        Hotels
      </a>


      <a
        href="/listings?category=desert"
        class="filter <%= category === 'desert' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-sun"></i>
        Desert
      </a>


      <a
        href="/listings?category=lake"
        class="filter <%= category === 'lake' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-water"></i>
        Lake
      </a>


      <a
        href="/listings?category=cities"
        class="filter <%= category === 'cities' ? 'active' : '' %>"
      >
        <i class="fa-solid fa-city"></i>
        Cities
      </a>


      <div class="tax-toggle">

        <label
          class="tax-switch"
          for="flexSwitchCheckDefault"
        >
          <input
            type="checkbox"
            id="flexSwitchCheckDefault"
            role="switch"
          >

          <span class="tax-slider"></span>
        </label>

        <label
          class="tax-label"
          for="flexSwitchCheckDefault"
        >
          Display total after taxes
        </label>

      </div>

    </div>

  </div>


  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

    <% if (allListings.length === 0) { %>

      <div class="col-12">
        <div class="no-listings">
          <h4>No listings found</h4>
          <p>
            Try another destination or category.
          </p>
        </div>
      </div>

    <% } %>


    <% for (let listing of allListings) { %>

      <div class="col">

        <a
          href="/listings/<%= listing._id %>"
          class="listing-link"
        >

          <div class="card listing-card">

            <img
              src="<%= listing.image.url %>"
              class="card-img-top"
              alt="listing-image"
            >

            <div class="card-img-overlay"></div>

            <div class="card-body">

              <p class="card-text">

                <b>
                  <%= listing.title %>
                </b>

                <br>

                <span class="price-line">

                  &#8377;
                  <%= listing.price.toLocaleString("en-IN") %>
                  /night

                  <i class="tax-info">
                    &nbsp;&nbsp; +18% GST
                  </i>

                </span>

              </p>

            </div>

          </div>

        </a>

      </div>

    <% } %>

  </div>


  <% if (totalPages > 1) { %>

    <div class="pagination-container">

      <% if (currentPage > 1) { %>

        <a
          href="/listings?page=<%= currentPage - 1 %><%= category ? '&category=' + category : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
          class="pagination-btn"
        >
          ← Previous
        </a>

      <% } %>


      <div class="page-numbers">

        <% for (let i = 1; i <= totalPages; i++) { %>

          <a
            href="/listings?page=<%= i %><%= category ? '&category=' + category : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
            class="page-number <%= currentPage === i ? 'active-page' : '' %>"
          >
            <%= i %>
          </a>

        <% } %>

      </div>


      <% if (currentPage < totalPages) { %>

        <a
          href="/listings?page=<%= currentPage + 1 %><%= category ? '&category=' + category : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"
          class="pagination-btn"
        >
          Next →
        </a>

      <% } %>

    </div>

  <% } %>

</div>


<script>
  const taxSwitch =
    document.getElementById("flexSwitchCheckDefault");

  if (taxSwitch) {

    taxSwitch.addEventListener("change", () => {

      const taxInfo =
        document.getElementsByClassName("tax-info");

      for (const info of taxInfo) {

        info.style.display =
          taxSwitch.checked
            ? "inline"
            : "none";

      }

    });

  }
</script>